# stlite bundle output — code + data are both build-time outputs.
# ``dashboard-static/files/``: python sources copied by build_stlite_bundle.py.
# ``dashboard-static/data/``:  witness parquets, either copied from
#                              local ``data/dashboard/`` (``--include-data``)
#                              or downloaded from the latest-data Release
#                              (``--fetch-from-release``).
# Only the hand-edited ``dashboard-static/index.html`` + README are checked in.
dashboard-static/files/
dashboard-static/data/
*.egg-info/
dist/
build/
.ruff_cache/
.pytest_cache/


# Local IDE/agent state
.claude/*
!.claude/skills/
.cursor/
.playwright-mcp/
.DS_Store
node_modules/
.wrangler/
.dev.vars
*.log

# Damage-seg dataset: annotations are the artefact worth keeping; photos,
# generated labels and overlays are bulky and reproducible from ann/ + harvest.
data/damage_seg/raw/
data/damage_seg/images/
data/damage_seg/overlays/
data/damage_seg/labels/
data/damage_seg/subset/
data/damage_seg/manifest.jsonl
data/damage_seg/exterior_filter.json
data/damage_seg/worklist.json
data/damage_seg/dataset.yaml
# Working state of the damage-seg annotation loop: labelling sheets are
# regenerated on every batch, and the CLIP/model rankings are recomputed
# whenever the pool or the detector changes. Only ann/ is the artefact.
data/damage_seg/sheets/
data/damage_seg/triage/
data/damage_seg/clip_damage_rank.json
data/damage_seg/model_rank.json
data/damage_seg/view_order.json
data/.last_scrape_start
